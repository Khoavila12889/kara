# Server Port
PORT=3001

# YouTube OAuth2 Credentials
YOUTUBE_CLIENT_ID=YOUR_YOUTUBE_CLIENT_ID
YOUTUBE_CLIENT_SECRET=YOUR_YOUTUBE_CLIENT_SECRET

# The full URL of the frontend application for CORS
# For local development, this is likely http://localhost:5173
# For production, use your actual domain (comma separated for multiple domains)
FRONTEND_URL=http://localhost:5173,http://192.168.1.100:5173

# The redirect URI must match EXACTLY what is in your Google Cloud Console
# It should be your frontend URL + /youtube-auth
REDIRECT_URI=http://localhost:5173/youtube-auth

# Environment (development/production)
NODE_ENV=development
