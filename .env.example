# YouTube API Configuration
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# YouTube OAuth2 Client ID (for PKCE flow)
VITE_YOUTUBE_CLIENT_ID=your_youtube_client_id_here

# Auth Proxy Server URL (where your auth proxy is hosted)
# For local development, this would be your auth proxy server address
VITE_AUTH_PROXY_URL=http://localhost:3001/api/youtube/callback

# Firebase Configuration (add your Firebase project config here)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id